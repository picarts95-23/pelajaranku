# =====================================================================
# Pelajaranku · Contoh konfigurasi Bring-Your-Own-Supabase
# =====================================================================
# Salin file ini menjadi `.env`, lalu isi dengan kredensial project
# Supabase milik Anda sendiri (gratis di https://supabase.com).
#
# Cara mendapatkan nilai-nilai di bawah:
#   1. Buat project baru di supabase.com (region terdekat).
#   2. Di Project Settings → API, salin: Project URL, anon public key,
#      dan service_role key.
#   3. Di Project Settings → General, salin Project Ref (string ~20 huruf).
# =====================================================================

# --- Wajib: dipakai oleh frontend (browser) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-PUBLIC-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- Wajib: dipakai oleh server (TanStack server functions) ---
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-PUBLIC-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- Wajib: konfigurasi peran admin & guru ---
# Email akun yang otomatis menjadi admin saat login pertama.
ADMIN_EMAIL="admin@sekolah-anda.sch.id"
# Kode akses rahasia yang wajib dimasukkan calon guru saat daftar.
TEACHER_ACCESS_CODE="ganti-dengan-kode-rahasia-yang-kuat"

# --- Opsional: fitur AI (asisten guru, latihan AI, draf TP) ---
# API key Gemini gratis: https://aistudio.google.com/apikey
GOOGLE_API_KEY=""
# Opsional, hanya untuk asisten guru bila memilih penyedia OpenAI:
OPENAI_API_KEY=""

# --- Opsional: sinkronisasi kalender guru ke Google Calendar ---
GCAL_STATE_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Opsional: backup ke Google Spreadsheet (langsung ke Google, tanpa perantara) ---
# Cara A (disarankan): Service Account dari Google Cloud Console
#   (aktifkan Google Sheets API + Google Drive API, buat service account, unduh JSON key).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Isi dengan nilai "private_key" dari JSON key (boleh memakai \n literal).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Email Google Anda: spreadsheet yang dibuat service account otomatis dibagikan ke sini.
GOOGLE_SHEETS_OWNER_EMAIL=""
# Cara B: refresh token OAuth akun Google Anda (memakai GOOGLE_CLIENT_ID/SECRET di atas).
# Awas: bila layar persetujuan OAuth masih "Testing", token kedaluwarsa tiap 7 hari.
GOOGLE_SHEETS_REFRESH_TOKEN=""
